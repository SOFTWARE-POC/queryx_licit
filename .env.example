# --- Obrigatórias -----------------------------------------------------------

# O MESMO Postgres da API principal. O serviço lê as tabelas de "public" (só
# leitura) e grava as suas no schema DB_SCHEMA. Recomendado: um usuário com
# SELECT em public e todas as permissões só no schema "relatorios".
DATABASE_URL=postgres://usuario:senha@host:5432/licitta

# API principal, para validar o token (GET /auth/me). No Railway, pela rede privada:
#   http://<servico-api>.railway.internal:<PORT>
MAIN_API_URL=http://localhost:3001

# --- Opcionais --------------------------------------------------------------

PORT=3000
NODE_ENV=production
# Schema próprio do serviço (relatórios, painéis e agendamentos da empresa).
DB_SCHEMA=relatorios
DB_POOL_MAX=10

# Fuso das datas (período, agrupamento por dia/semana/mês, horário dos envios).
REPORTS_TIMEZONE=America/Sao_Paulo
# Jornada diária padrão (min) para "horas acima da jornada".
STANDARD_WORKDAY_MINUTES=480
# Tolerância (min) antes de contar atraso contra a escala.
LATE_TOLERANCE_MINUTES=10

# Tempo máximo de uma consulta do BI (o pool de consultas é só leitura).
QUERY_TIMEOUT_MS=15000
# Cache da validação do token na API principal.
AUTH_CACHE_TTL_SECONDS=30
TRUST_PROXY=1
THROTTLE_LIMIT=600

# --- Envio agendado por e-mail ----------------------------------------------
# disabled (padrão) | log (só registra) | smtp | resend
MAIL_PROVIDER=disabled
MAIL_FROM=Licitta Relatórios <relatorios@seudominio.com.br>
# SMTP_URL=smtps://usuario:senha@smtp.seudominio.com.br:465
# RESEND_API_KEY=re_xxx
# Link "Abrir no painel" no e-mail.
PANEL_URL=https://www.kodahub.com.br
# false desliga o relógio dos envios (ex.: réplica extra do serviço).
SCHEDULER_ENABLED=true
